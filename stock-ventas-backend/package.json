{
  "name": "stock-ventas-backend",
  "version": "1.0.0",
  "description": "Backend del sistema de gestión de stock y ventas",
  "main": "dist/server.js",
  "scripts": {
    "predev": "node scripts/ensure-postgres.js",
    "predev:docker": "node scripts/ensure-docker.js",
    "dev:docker": "npm run predev:docker && tsx watch src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "puppeteer-core": "^25.14.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "oxlint": "^1.88.0",
    "pg": "^8.23.1",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^5.0.5"
  }
}

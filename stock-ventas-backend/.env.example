# ─────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────
# Cadena de conexión a PostgreSQL. Formato:
# postgresql://usuario:password@host:puerto/nombre_base
#
# Si usás Docker (stock-ventas-db, ver README):
DATABASE_URL="postgresql://postgres:password@localhost:5432/stock_ventas"
#
# Si usás PostgreSQL instalado nativo en Windows, reemplazá "password"
# por la contraseña del superusuario "postgres" que definiste durante
# la instalación, y "stock_ventas" es el nombre de la base (se crea sola
# la primera vez que corre el sistema si no existe).

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
# Puerto donde escucha el backend. Default: 3000
PORT=3000

# "development" o "production". Afecta el nivel de logging de Prisma.
NODE_ENV=development

# ─────────────────────────────────────────────
# Autenticación (JWT)
# ─────────────────────────────────────────────
# Secreto para firmar los tokens de sesión. OBLIGATORIO, no dejar vacío.
# Generar uno propio con: openssl rand -hex 32
JWT_SECRET=""

# Duración del token antes de expirar. Default: 8h
JWT_EXPIRES_IN="8h"

# ─────────────────────────────────────────────
# ARCA (ex-AFIP) — Facturación electrónica
# ─────────────────────────────────────────────
# "mock"          → no llama a ningún servicio real, genera un CAE simulado.
#                    Es el default, no requiere CUIT ni certificado.
# "homologacion"  → ambiente de pruebas real de ARCA.
# "produccion"    → ambiente real, requiere certificado digital y CUIT habilitado.
ARCA_MODO="mock"

# --- Datos del emisor (tu empresa) ---
# Usados para armar el comprobante y para decidir Factura A/B/C.
ARCA_CUIT_EMISOR=""
ARCA_RAZON_SOCIAL="Mi Empresa"

# Una de: RESPONSABLE_INSCRIPTO | MONOTRIBUTO | CONSUMIDOR_FINAL | EXENTO
ARCA_CONDICION_IVA_EMISOR="MONOTRIBUTO"

# Punto de venta habilitado en ARCA (número, sin ceros a la izquierda)
ARCA_PUNTO_VENTA=1

# Datos que aparecen en el encabezado del comprobante impreso
ARCA_DOMICILIO_COMERCIAL=""
ARCA_INGRESOS_BRUTOS=""
# Formato libre, tal cual se muestra en el comprobante (ej: "01/2020")
ARCA_FECHA_INICIO_ACTIVIDADES=""

# --- Certificado digital ---
# Solo necesario si ARCA_MODO es "homologacion" o "produccion".
# Rutas absolutas al certificado (.crt) y clave privada (.key) emitidos
# por ARCA desde el portal "Administración de Certificados Digitales".
# En modo "mock" dejar vacío.
ARCA_CERT_PATH=""
ARCA_KEY_PATH=""

# --- Endpoints SOAP de ARCA ---
# No hace falta tocarlos salvo que ARCA cambie las URLs oficiales.
# Estos son los de homologación (ambiente de pruebas); para producción
# ARCA usa otras URLs (wsaa.afip.gov.ar / wsfe.afip.gov.ar, sin "homo").
ARCA_WSAA_URL="https://wsaahomo.afip.gov.ar/ws/services/LoginCms"
ARCA_WSFE_URL="https://wswhomo.afip.gov.ar/wsfev1/service.asmx"

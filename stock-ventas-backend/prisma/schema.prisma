// schema.prisma — Sistema de Gestión de Stock y Ventas
// Base de datos: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Rol {
  ADMIN
  VENDEDOR
}

enum TipoMovimientoStock {
  VENTA
  COMPRA
  AJUSTE
  DEVOLUCION
  AJUSTE_INICIAL
}

enum TipoMovimientoCuentaCorriente {
  CARGO // aumenta la deuda del cliente (ej: venta a cuenta corriente)
  PAGO  // reduce la deuda del cliente
  AJUSTE // corrección manual (positiva o negativa)
}

enum EstadoVenta {
  CONFIRMADA
  ANULADA
}

enum EstadoCompra {
  RECIBIDA
  PENDIENTE
}

enum FormaPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

// Usados para el comprobante fiscal (integración ARCA / ex-AFIP)
enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  CONSUMIDOR_FINAL
  EXENTO
}

enum TipoComprobante {
  FACTURA_A
  FACTURA_B
  FACTURA_C
}

// ─────────────────────────────────────────────
// Usuarios
// ─────────────────────────────────────────────

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  usuario      String   @unique
  passwordHash String   @map("password_hash")
  rol          Rol      @default(VENDEDOR)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")
  
  ventas            Venta[]
  movimientosStock  MovimientoStock[]
  cajaAperturas     Caja[]
  movimientosCuentaCorriente MovimientoCuentaCorriente[]
  @@map("usuarios")
}

// ─────────────────────────────────────────────
// Categorías y Productos
// ─────────────────────────────────────────────

model Categoria {
  id       Int        @id @default(autoincrement())
  nombre   String     @unique
  productos Producto[]

  @@map("categorias")
}

model Producto {
  id            Int      @id @default(autoincrement())
  sku           String   @unique
  codigoBarras  String?  @unique @map("codigo_barras")
  nombre        String
  categoriaId   Int?     @map("categoria_id")
  precioCosto   Decimal  @map("precio_costo") @db.Decimal(12, 2)
  precioVenta   Decimal  @map("precio_venta") @db.Decimal(12, 2)
  stockActual   Int      @default(0) @map("stock_actual")
  stockMinimo   Int      @default(0) @map("stock_minimo")
  // Datos fiscales para el comprobante ARCA: alícuota de IVA del producto
  // (21, 10.5, 27, 5, 2.5 o 0) y su unidad de medida (texto libre).
  alicuotaIva   Decimal  @default(21.00) @map("alicuota_iva") @db.Decimal(4, 2)
  unidadMedida  String   @default("unidades") @map("unidad_medida")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  categoria         Categoria?         @relation(fields: [categoriaId], references: [id])
  movimientosStock  MovimientoStock[]
  ventaItems        VentaItem[]
  compraItems       CompraItem[]
  promociones       Promocion[]

  @@index([nombre])
  @@index([stockActual])
  @@map("productos")
}

// ─────────────────────────────────────────────
// Movimientos de stock (fuente de verdad de auditoría)
// ─────────────────────────────────────────────

model MovimientoStock {
  id              Int                 @id @default(autoincrement())
  productoId      Int                 @map("producto_id")
  tipo            TipoMovimientoStock
  cantidad        Int                 // positivo = alta, negativo = baja
  fecha           DateTime            @default(now())
  usuarioId       Int                 @map("usuario_id")
  referenciaTipo  String?             @map("referencia_tipo") // "venta" | "compra" | null
  referenciaId    Int?                @map("referencia_id")
  motivo          String?

  producto Producto @relation(fields: [productoId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([productoId])
  @@index([fecha])
  @@map("movimientos_stock")
}

// ─────────────────────────────────────────────
// Clientes
// ─────────────────────────────────────────────

model Cliente {
  id                   Int      @id @default(autoincrement())
  nombre               String
  telefono             String?
  email                String?
  cuentaCorrienteSaldo Decimal  @default(0) @map("cuenta_corriente_saldo") @db.Decimal(12, 2)
  creadoEn             DateTime @default(now()) @map("creado_en")
  cuit         String?       @map("cuit")
  condicionIva CondicionIva? @map("condicion_iva")
  domicilioComercial String? @map("domicilio_comercial")

  ventas Venta[]
  movimientosCuentaCorriente MovimientoCuentaCorriente[]
  @@map("clientes")
}

model MovimientoCuentaCorriente {
  id             Int                           @id @default(autoincrement())
  clienteId      Int                           @map("cliente_id")
  tipo           TipoMovimientoCuentaCorriente
  monto          Decimal                       @db.Decimal(12, 2) // signado: positivo = aumenta deuda, negativo = la reduce
  fecha          DateTime                      @default(now())
  usuarioId      Int                           @map("usuario_id")
  referenciaTipo String?                       @map("referencia_tipo") // "venta" | null
  referenciaId   Int?                          @map("referencia_id")
  motivo         String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([clienteId])
  @@index([fecha])
  @@map("movimientos_cuenta_corriente")
}

// ─────────────────────────────────────────────
// Ventas
// ─────────────────────────────────────────────

model Venta {
  id          Int         @id @default(autoincrement())
  clienteId   Int?        @map("cliente_id")
  usuarioId   Int         @map("usuario_id")
  fecha       DateTime    @default(now())
  total       Decimal     @db.Decimal(12, 2)
  descuento   Decimal     @default(0) @db.Decimal(12, 2)
  formaPago   FormaPago   @map("forma_pago")
  estado      EstadoVenta @default(CONFIRMADA)
  motivoAnulacion String? @map("motivo_anulacion")
  // Datos del comprobante fiscal ARCA (ex-AFIP). Null hasta que se pide el CAE
  // (se pide una sola vez, la primera vez que se abre el comprobante).
  tipoComprobante   TipoComprobante? @map("tipo_comprobante")
  puntoVenta        Int?             @map("punto_venta")
  numeroComprobante Int?             @map("numero_comprobante")
  cae               String?          @map("cae")
  caeVencimiento    DateTime?        @map("cae_vencimiento")

  cliente Cliente?    @relation(fields: [clienteId], references: [id])
  usuario Usuario     @relation(fields: [usuarioId], references: [id])
  items   VentaItem[]

  @@index([fecha])
  @@index([estado])
  @@map("ventas")
}

model VentaItem {
  id             Int     @id @default(autoincrement())
  ventaId        Int     @map("venta_id")
  productoId     Int     @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  bonificacionPorcentaje Decimal @default(0) @map("bonificacion_porcentaje") @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId])
  @@map("venta_items")
}

// ─────────────────────────────────────────────
// Proveedores y Compras
// ─────────────────────────────────────────────

model Proveedor {
  id       Int      @id @default(autoincrement())
  nombre   String
  contacto String?
  telefono String?
  email    String?
  creadoEn DateTime @default(now()) @map("creado_en")

  compras Compra[]

  @@map("proveedores")
}

model Compra {
  id          Int          @id @default(autoincrement())
  proveedorId Int          @map("proveedor_id")
  fecha       DateTime     @default(now())
  total       Decimal      @db.Decimal(12, 2)
  estado      EstadoCompra @default(RECIBIDA)

  proveedor Proveedor    @relation(fields: [proveedorId], references: [id])
  items     CompraItem[]

  @@map("compras")
}

model CompraItem {
  id             Int     @id @default(autoincrement())
  compraId       Int     @map("compra_id")
  productoId     Int     @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)

  compra   Compra   @relation(fields: [compraId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("compra_items")
}

// ─────────────────────────────────────────────
// Caja
// ─────────────────────────────────────────────

model Caja {
  id                Int       @id @default(autoincrement())
  usuarioId         Int       @map("usuario_id")
  fechaApertura     DateTime  @default(now()) @map("fecha_apertura")
  fechaCierre       DateTime? @map("fecha_cierre")
  montoInicial      Decimal   @map("monto_inicial") @db.Decimal(12, 2)
  montoFinalContado Decimal?  @map("monto_final_contado") @db.Decimal(12, 2)
  montoFinalEsperado Decimal? @map("monto_final_esperado") @db.Decimal(12, 2)
  diferencia        Decimal?  @db.Decimal(12, 2)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("caja")
}

// ─────────────────────────────────────────────
// Promociones
// ─────────────────────────────────────────────

enum TipoPromocion {
  DOS_POR_UNO
  DESCUENTO_PORCENTUAL
  SEGUNDA_UNIDAD
}

model Promocion {
  id             Int            @id @default(autoincrement())
  nombre         String
  tipo           TipoPromocion
  productoId     Int?           @map("producto_id")
  valor          Decimal        @db.Decimal(5, 2)
  cantidadMinima Int            @default(1) @map("cantidad_minima")
  activo         Boolean        @default(true)
  fechaInicio    DateTime?      @map("fecha_inicio")
  fechaFin       DateTime?      @map("fecha_fin")
  creadoEn       DateTime       @default(now()) @map("creado_en")
  actualizadoEn  DateTime       @updatedAt @map("actualizado_en")

  producto Producto? @relation(fields: [productoId], references: [id])

  @@map("promociones")
}
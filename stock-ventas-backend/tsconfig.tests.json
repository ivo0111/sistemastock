{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // tests/vitest.config usan ESM (import.meta): se chequea el mismo código
    // con module ESM en vez del commonjs del build.
    "module": "ES2022",
    "moduleResolution": "node"
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.mts"],
  "exclude": ["node_modules", "dist"]
}
